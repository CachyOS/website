---
import { Image } from 'astro:assets';
//import Image from '~/components/common/Image.astro';
import DropdownMenu from '~/components/widgets/DropdownMenu';
import { ISOEdition, ISOSource, generateDownloadLink } from '~/utils/utils';
import versions from '~/versions';

interface DropdownMenuProps {
  title: string;
  direct_url: string;
  srcforge_url?: string;
  magenet_url?: string;
  torrent_url?: string;
}

const [desktop_magnet, handheld_magnet] = await Promise.all(
  [
    generateDownloadLink(ISOEdition.DESKTOP, versions.desktopISOVersion, ISOSource.MAGNET),
    generateDownloadLink(ISOEdition.HANDHELD, versions.handheldISOVersion, ISOSource.MAGNET),
  ].map(async (url) =>
    fetch(url)
      .then((res) => res.text())
      .catch(() => url)
  )
);

const items = [
  [
    {
      title: 'Desktop Edition',
      description:
        'Empower your computing with a modern, customizable desktop environment — browse the web, stay connected with friends and family, manage files, enjoy multimedia, and work efficiently in a visually stunning interface that adapts to your needs. Benefit from Free and Open Source Software with a focus on security, privacy, and peace of mind.',
      direct_url: generateDownloadLink(
        ISOEdition.DESKTOP,
        versions.desktopISOVersion,
        ISOSource.DIRECT
      ),
      srcforge_url: generateDownloadLink(
        ISOEdition.DESKTOP,
        versions.desktopISOVersion,
        ISOSource.SOURCEFORGE
      ),
      magnet_url: desktop_magnet,
      torrent_url: generateDownloadLink(
        ISOEdition.DESKTOP,
        versions.desktopISOVersion,
        ISOSource.TORRENT
      ),
      preview: import('~/assets/images/kde.png'),
    },
    {
      title: 'Handheld Edition',
      description:
        'The CachyOS Handheld Edition provides a GameMode like experience and comes with preinstalled gaming tools. It officially supports the Rog Ally, Steam Deck OLED and LCD, Legion GO and Lenovo Legion Go S.',
      direct_url: generateDownloadLink(
        ISOEdition.HANDHELD,
        versions.handheldISOVersion,
        ISOSource.DIRECT
      ),
      srcforge_url: generateDownloadLink(
        ISOEdition.HANDHELD,
        versions.handheldISOVersion,
        ISOSource.SOURCEFORGE
      ),
      magnet_url: handheld_magnet,
      torrent_url: generateDownloadLink(
        ISOEdition.HANDHELD,
        versions.handheldISOVersion,
        ISOSource.TORRENT
      ),
      preview: import('~/assets/images/handheld.png'),
    },
  ],
];
---

<section class="scroll-mt-16">
  <div class="flex x-auto space-y-6 justify-center md:space-y-0 p-9">
    {
      items.map((subitems) => (
        <div class="container sm:px-8 mx-auto">
          {subitems.map(
            ({
              title,
              description,
              direct_url,
              srcforge_url,
              magnet_url,
              torrent_url,
              preview,
            }) => (
              <div class="flex flex-wrap items-center -m-8 my-20 pb-[calc(20vh)]">
                <div class="w-full md:w-1/2 p-8">
                  <h2 class="mb-9 text-6xl md:text-8xl xl:text-10xl font-bold font-heading tracking-px-n leading-none">
                    {title}
                  </h2>
                  <p class="mb-10 text-lg text-gray-900 dark:text-slate-400 font-medium leading-relaxed md:max-w-md">
                    {description}
                  </p>
                  <div class="mb-11 md:inline-block rounded-xl shadow-4xl bg-primary-500 dark:bg-primary-700 dropdown">
                    {direct_url && (
                      <DropdownMenu
                        client:load
                        data={
                          {
                            title,
                            direct_url,
                            srcforge_url,
                            magnet_url,
                            torrent_url,
                          } as DropdownMenuProps
                        }
                      />
                    )}
                    {!direct_url && !srcforge_url && (
                      <div>
                        <button type="button" class="btn-under-constuction py-4 px-6">
                          Under construction 🚧
                        </button>
                      </div>
                    )}
                  </div>
                </div>
                <div class="w-full md:w-1/2 p-8">
                  {preview && (
                    <Image
                      src={preview}
                      class="transform hover:-translate-x-16 rounded-xl transition ease-in-out duration-1000"
                      alt=""
                      loading="eager"
                      width={1920}
                      height={1080}
                    />
                  )}
                </div>
              </div>
            )
          )}
        </div>
      ))
    }
  </div>
</section>
