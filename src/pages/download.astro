---
import { SITE } from '~/config.mjs';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import Layout from '~/layouts/PageLayout.astro';
import BackgroundGradient from '~/components/common/BackgroundGradient.astro';
import Editions from '~/components/widgets/Editions.astro';

const meta = {
  title: `Download`,
  description: `Find a suitable ${SITE.name} edition for your hardware.`,
  canonical: getCanonical(getPermalink('/download/')),
};
---

<Layout {meta}>
  <BackgroundGradient position="center" rotate="rotate-30" variant="blob" noiseLayers={2} />
  <Editions />
</Layout>
