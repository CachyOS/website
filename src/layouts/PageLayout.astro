---
import Layout from '~/layouts/BaseLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import type { MetaSEO } from '~/types';

export interface Props {
  meta?: MetaSEO;
  /** The page has a copy in every language (src/pages/<lang>/). */
  translated?: boolean;
}

const { meta, translated = false } = Astro.props;
---

<Layout {meta} {translated}>
  <slot name="header">
    <Header {translated} />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer />
  </slot>
</Layout>
