---
import { Image } from 'astro:assets';
import DropdownMenu from '~/components/widgets/DropdownMenu';
import { ISOEdition, ISOSource, generateDownloadLink } from '~/utils/utils';
import versions from '~/versions';
import desktopImage from '~/assets/images/desktop_dark.png';
import handheldImage from '~/assets/images/handheld.png';

const [desktop_magnet = '', handheld_magnet = ''] = await Promise.all(
  [
    generateDownloadLink(ISOEdition.DESKTOP, versions.desktopISOVersion, ISOSource.MAGNET),
    generateDownloadLink(ISOEdition.HANDHELD, versions.handheldISOVersion, ISOSource.MAGNET),
  ].map(async (url) =>
    fetch(url)
      .then((res) => res.text())
      .catch(() => url)
  )
);

const items = [
  [
    {
      title: 'Desktop Edition',
      description: `A fully optimized Arch Linux desktop with CPU-specific package builds, a tuned kernel, and your choice of desktop environment. Browse, develop, create, and game on a system built for speed - powered entirely by free and open-source software. <br/><br/> Many Desktop Environments Available: The online installer lets you choose from 17+ environments, including KDE Plasma, GNOME, COSMIC, Hyprland, Niri, Sway, i3, XFCE, <a class="underline decoration-2 underline-offset-2 text-surface-700 dark:text-primary-500/90" href="https://wiki.cachyos.org/installation/desktop_environments/">and more</a>.`,
      direct_url: generateDownloadLink(
        ISOEdition.DESKTOP,
        versions.desktopISOVersion,
        ISOSource.DIRECT
      ),
      srcforge_url: generateDownloadLink(
        ISOEdition.DESKTOP,
        versions.desktopISOVersion,
        ISOSource.SOURCEFORGE
      ),
      magnet_url: desktop_magnet,
      torrent_url: generateDownloadLink(
        ISOEdition.DESKTOP,
        versions.desktopISOVersion,
        ISOSource.TORRENT
      ),
      preview: desktopImage,
    },
    {
      title: 'Handheld Edition',
      description: `The CachyOS Handheld Edition provides a GameMode-like experience and comes with preinstalled gaming tools. It officially supports the ROG Ally, Steam Deck OLED and LCD, Legion Go, and Lenovo Legion Go S. At the moment, only KDE Plasma is supported.`,
      direct_url: generateDownloadLink(
        ISOEdition.HANDHELD,
        versions.handheldISOVersion,
        ISOSource.DIRECT
      ),
      srcforge_url: generateDownloadLink(
        ISOEdition.HANDHELD,
        versions.handheldISOVersion,
        ISOSource.SOURCEFORGE
      ),
      magnet_url: handheld_magnet,
      torrent_url: generateDownloadLink(
        ISOEdition.HANDHELD,
        versions.handheldISOVersion,
        ISOSource.TORRENT
      ),
      preview: handheldImage,
    },
  ],
];
---

<section class="pt-12 md:pt-24 pb-20 md:pb-52">
  <div class="mx-auto max-w-6xl grid gap-12 md:gap-18 px-3 md:px-6 space-y-20 md:space-y-52">
    {
      items.map((subitems) =>
        subitems.map(
          ({ title, description, direct_url, srcforge_url, magnet_url, torrent_url, preview }) => (
            <div class="flex flex-wrap md:flex-nowrap items-center md:space-x-10">
              <div class="w-full md:w-1/2">
                <h2 class="mb-9 text-4xl md:text-6xl xl:text-8xl font-bold font-heading leading-none text-nowrap lg:text-wrap md:max-w-md">
                  {title}
                </h2>
                <p
                  class="mb-10 text-lg text-gray-900 dark:text-gray-400 font-medium leading-relaxed md:max-w-md whitespace-pre-line"
                  set:html={description}
                />
                <div class="mb-11 md:inline-block rounded-xl shadow-4xl dropdown">
                  {direct_url && (
                    <DropdownMenu
                      client:load
                      data={{
                        title,
                        direct_url,
                        srcforge_url,
                        magnet_url,
                        torrent_url,
                      }}
                    />
                  )}
                  {!direct_url && !srcforge_url && (
                    <div>
                      <button type="button" class="under-construction py-4 px-6">
                        Under construction 🚧
                      </button>
                    </div>
                  )}
                </div>
              </div>
              <div class="w-full md:w-1/2">
                {preview && (
                  <Image
                    src={preview}
                    class="transform lg:hover:-translate-x-8 rounded-xl transition ease-in-out duration-700"
                    alt={`${title} preview`}
                    decoding="async"
                    loading="lazy"
                    layout="constrained"
                    width="900"
                  />
                )}
              </div>
            </div>
          )
        )
      )
    }
  </div>
</section>
