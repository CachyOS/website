---
import { getCanonical, getPermalink } from '~/utils/permalinks';
import Layout from '~/layouts/PageLayout.astro';
import BackgroundGradient from '~/components/common/BackgroundGradient.astro';
import Distribution from '~/components/widgets/AboutDistribution.astro';
import Team from '~/components/widgets/Team.astro';

const meta = {
  title: `About us`,
  description: `Meet the team behind CachyOS and learn about the performance-optimized Arch Linux distribution.`,
  canonical: getCanonical(getPermalink('/about/')),
};
---

<Layout {meta}>
  <BackgroundGradient position="center" rotate="rotate-230" variant="stripe" noiseLayers={2} stripeDensity="dense" />
  <Distribution />
  <Team />
</Layout>
