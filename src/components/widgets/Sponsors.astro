---
import { Image } from 'astro:assets';
import cdn77Logo from '~/assets/images/cdn77_logo.svg';
import cloudflareLogo from '~/assets/images/cf_logo.svg';
import frameworkLogo from '~/assets/images/framework_logo.svg';

const sponsors = [
  { href: 'https://frame.work/', src: frameworkLogo, alt: 'frame.work' },
  { href: 'https://www.cdn77.com/', src: cdn77Logo, alt: 'www.cdn77.com' },
  {
    href: 'https://www.cloudflare.com/',
    src: cloudflareLogo,
    alt: 'www.cloudflare.com',
    imageClassName: 'mb-5',
  },
];
---

<section class="py-20">
  <div class="container px-4 mx-auto">
    <div class="max-w-xl mx-auto mb-20 text-center">
      <h2 class="mt-8 text-5xl lg:text-6xl font-bold font-heading">Our Sponsors</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 grid-flow-row auto-rows-fr">
      {
        sponsors.map(({ href, src, alt, imageClassName }) => (
          <div class="px-4 py-4 md:py-6 bg-gray-800 dark:bg-gray-800/80 rounded-lg grid place-items-center">
            <a href={href}>
              <Image
                src={src}
                class={`transform hover:scale-105 transition ease-in-out duration-1000 ${imageClassName ?? ''}`}
                alt={alt}
                loading="lazy"
                decoding="async"
                width={230}
                layout="constrained"
              />
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
