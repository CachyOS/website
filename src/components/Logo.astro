  class="self-center"
  src={logoSrc.src}
  loading="eager"
  decoding="async"
  alt="CachyOS logo"
  width="32"
  height="32"
/>
<span
  class="self-center ml-2 text-2xl md:text-xl font-bold text-surface-700 whitespace-nowrap dark:text-surface-50"
>
  CachyOS</span
>
