---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import ptr1337Avatar from '~/assets/images/ptr1337_avatar.png';
import cppCode from '~/assets/images/cpp_code.jpg';
import logo from '~/assets/images/logo.svg';
import soulharsh007Avatar from '~/assets/images/soulharsh007_avatar.png';
import loathingkernelAvatar from '~/assets/images/loathingkernel_avatar.png';
import vildaAvatar from '~/assets/images/vilda_avatar.png';
import nextworksAvatar from '~/assets/images/nextworks_avatar.png';
import shendisxAvatar from '~/assets/images/shendisx_avatar.png';
import azdanovAvatar from '~/assets/images/azdanov_avatar.png';

const items = [
  {
    name: 'Peter Jung (ptr1337)',
    description: 'Founder, Developer',
    avatar: ptr1337Avatar,
    github_url: 'https://github.com/ptr1337',
  },
  {
    name: 'Vladislav Nepogodin (vnepogodin)',
    description: 'Founder, Developer',
    avatar: cppCode,
    github_url: 'https://github.com/vnepogodin',
  },
  {
    name: 'Piotr Gorski (sir_lucjan)',
    description: 'Kernel maintainer, scx contributor, University lecturer from Poland',
    avatar: logo,
    github_url: 'https://github.com/sirlucjan',
  },
  {
    name: 'Vasiliy Stelmachenok (ventureoo)',
    description: 'Developer, chwd and cachyos-settings, package maintainer',
    avatar: logo,
    github_url: 'https://github.com/ventureoo',
  },
  {
    name: 'Eric Naim (naim)',
    description: 'Package and Kernel Maintainer',
    avatar: logo,
    github_url: 'https://github.com/1Naim',
  },
  {
    name: 'Harsh Peshwani (SoulHarsh007)',
    description: 'Developer, Maintainer of Cachy Chroot, Website, Builder Dashboard',
    avatar: soulharsh007Avatar,
    github_url: 'https://github.com/SoulHarsh007',
  },
  {
    name: 'Nekoh',
    description: 'Developer, Maintainer of CachyOS Handheld Edition',
    avatar: logo,
    github_url: 'https://github.com/Pogogo007',
  },
  {
    name: 'Stelios Tsampas (loathingKernel)',
    description: 'Developer, Maintainer of CachyOS Wine & Proton',
    avatar: loathingkernelAvatar,
    github_url: 'https://github.com/loathingKernel',
  },
  {
    name: 'Vědomil Vildomec (Vilda)',
    description: 'Contributor, Wiki, Documentation, Tutorials',
    avatar: vildaAvatar,
    github_url: 'https://github.com/SoongVilda',
  },
  {
    name: 'firelzrd',
    description: 'BORE Scheduler',
    avatar: logo,
    github_url: 'https://github.com/firelzrd',
  },
  {
    name: 'Luca Paglia (NextWorks)',
    description: 'GFX, ART',
    avatar: nextworksAvatar,
    github_url: 'https://github.com/NextWork123',
  },
  {
    name: 'Matias (Aarrayy)',
    description: 'Contributor, Wiki, Tester, CachyOS Ricer',
    avatar: shendisxAvatar,
    github_url: 'https://github.com/Aarrayy',
  },
  {
    name: 'Anton Ždanov (azdanov)',
    description: 'Developer, Contributor, Wiki, Tester',
    avatar: azdanovAvatar,
    github_url: 'https://github.com/azdanov',
  },
];
---

<section class="py-28 overflow-hidden" id="team">
  <div class="py-8 px-4 mx-auto max-w-(--breakpoint-xl) text-center lg:py-16 lg:px-6">
    <div class="mx-auto mb-8 max-w-(--breakpoint-sm) lg:mb-16">
      <h2 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white">
        Meet our team!
      </h2>
      <p class="font-light text-gray-500 sm:text-xl dark:text-gray-400">
        Meet the people behind CachyOS!
      </p>
    </div>
    <div class="grid gap-8 lg:gap-16 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {
        items.map(({ name, description, avatar, github_url }) => (
          <div class="text-center text-gray-500 dark:text-gray-400 flex flex-col rounded-lg h-96">
            <div class="flex flex-row justify-center">
              <Image
                src={avatar}
                class="transform hover:scale-105 transition ease-in-out duration-1000 aspect-square object-contain hidden md:block"
                alt={`Avatar of ${name}`}
                width={512}
                height={512}
              />
              <Image
                src={avatar}
                class="transform hover:scale-105 transition ease-in-out duration-1000 aspect-square object-contain md:hidden"
                alt={`Avatar of ${name}`}
                width={256}
                height={256}
              />
            </div>
            <ul class="flex justify-center mt-2 space-x-4">
              <li>
                <a
                  class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-hidden focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label="Github"
                  href={github_url}
                >
                  <Icon name="tabler:brand-github" class="w-5 h-5" />
                </a>
              </li>
            </ul>
            <h3 class="mb-1 text-xl font-bold tracking-tight text-gray-900 dark:text-white">
              {name}
            </h3>
            <p class="mb-4 text-sm font-medium">{description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
