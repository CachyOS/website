---
import { Icon } from 'astro-icon/components';
---

<section class="relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="py-12 md:py-20">
      <div
        class="max-w-3xl mx-auto text-center p-6 rounded-md shadow-xl dark:shadow-none dark:border dark:border-slate-600 dark:bg-gradient-to-br dark:from-gray-900 dark:to-violet-950/30"
      >
        <h2
          class="text-4xl md:text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading"
        >
          <span class="sm:whitespace-nowrap">Ready to See the Difference?</span>
        </h2>
        <p class="text-xl text-gray-600 dark:text-slate-400">
          Download CachyOS and experience what a performance-optimized Linux distribution feels
          like.
        </p>

        <div class="mt-6 max-w-xs mx-auto">
          <a class="btn btn-primary w-full sm:w-auto" href="/download">
            <Icon name="tabler:download" class="w-5 h-5 mr-1 -ml-1.5" /> Download
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
