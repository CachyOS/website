---
import { Image } from 'astro:assets';
import DropdownMenu from '~/components/widgets/DropdownMenu';
import { ISOEdition, ISOSource, generateDownloadLink } from '~/utils/utils';
import versions from '~/versions';
import desktopImage from '~/assets/images/desktop_dark.png';
import handheldImage from '~/assets/images/handheld.png';
import { getLangFromUrl, useTranslations } from '../../i18n';
const t = useTranslations(getLangFromUrl(Astro.url));

const [desktop_magnet = '', handheld_magnet = ''] = await Promise.all(
  [
    generateDownloadLink(ISOEdition.DESKTOP, versions.desktopISOVersion, ISOSource.MAGNET),
    generateDownloadLink(ISOEdition.HANDHELD, versions.handheldISOVersion, ISOSource.MAGNET),
  ].map(async (url) =>
    fetch(url)
      .then((res) => res.text())
      .catch(() => url)
  )
);

const items = [
  [
    {
      name: 'Desktop Edition',
      title: t('editions.desktop_title'),
      description: t('editions.desktop_description'),
      direct_url: generateDownloadLink(
        ISOEdition.DESKTOP,
        versions.desktopISOVersion,
        ISOSource.DIRECT
      ),
      srcforge_url: generateDownloadLink(
        ISOEdition.DESKTOP,
        versions.desktopISOVersion,
        ISOSource.SOURCEFORGE
      ),
      magnet_url: desktop_magnet,
      torrent_url: generateDownloadLink(
        ISOEdition.DESKTOP,
        versions.desktopISOVersion,
        ISOSource.TORRENT
      ),
      preview: desktopImage,
    },
    {
      name: 'Handheld Edition',
      title: t('editions.handheld_title'),
      description: t('editions.handheld_description'),
      direct_url: generateDownloadLink(
        ISOEdition.HANDHELD,
        versions.handheldISOVersion,
        ISOSource.DIRECT
      ),
      srcforge_url: generateDownloadLink(
        ISOEdition.HANDHELD,
        versions.handheldISOVersion,
        ISOSource.SOURCEFORGE
      ),
      magnet_url: handheld_magnet,
      torrent_url: generateDownloadLink(
        ISOEdition.HANDHELD,
        versions.handheldISOVersion,
        ISOSource.TORRENT
      ),
      preview: handheldImage,
    },
  ],
];
---

<section class="pt-12 md:pt-24 pb-20 md:pb-52">
  <div class="mx-auto max-w-6xl grid gap-12 md:gap-18 px-3 md:px-6 space-y-20 md:space-y-52">
    {
      items.map((subitems) =>
        subitems.map(
          ({
            name,
            title,
            description,
            direct_url,
            srcforge_url,
            magnet_url,
            torrent_url,
            preview,
          }) => (
            <div class="flex flex-wrap md:flex-nowrap items-center md:space-x-10">
              <div class="w-full md:w-1/2">
                <h2 class="mb-9 text-4xl md:text-6xl xl:text-8xl font-bold font-heading leading-none text-nowrap lg:text-wrap md:max-w-md">
                  {title}
                </h2>
                <p
                  class="mb-10 text-lg text-gray-900 dark:text-gray-400 font-medium leading-relaxed md:max-w-md whitespace-pre-line"
                  set:html={description}
                />
                <div class="mb-11 md:inline-block rounded-xl shadow-4xl dropdown">
                  {direct_url && (
                    <DropdownMenu
                      client:load
                      data={{
                        name,
                        title,
                        direct_url,
                        srcforge_url,
                        magnet_url,
                        torrent_url,
                      }}
                    />
                  )}
                  {!direct_url && !srcforge_url && (
                    <div>
                      <button type="button" class="under-construction py-4 px-6">
                        {t('editions.under_construction_button')}
                      </button>
                    </div>
                  )}
                </div>
              </div>
              <div class="w-full md:w-1/2">
                {preview && (
                  <Image
                    src={preview}
                    class="transform lg:hover:-translate-x-8 rounded-xl transition ease-in-out duration-700"
                    alt={t('editions.preview_title', { title })}
                    decoding="async"
                    loading="lazy"
                    layout="constrained"
                    width="900"
                  />
                )}
              </div>
            </div>
          )
        )
      )
    }
  </div>
</section>
