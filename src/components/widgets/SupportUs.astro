---
import { Icon } from 'astro-icon/components';
import SupportOptions from './SupportOptions';
---

<section>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 overflow-hidden">
    <div class="py-12 md:py-20">
      <div class="py-4 sm:py-6 lg:py-8">
        <div class="flex flex-wrap md:-mx-8">
          <div class="w-full lg:w-1/2 px-0 sm:px-8">
            <div class="mb-12 lg:mb-0 pb-12 lg:pb-0 border-b lg:border-b-0">
              <div class="flex flex-row gap-x-2">
                <div
                  class="w-11 h-11 flex items-center justify-center p-0.75 rounded-full ring-1 ring-gray-900/10 shadow-sm overflow-hidden dark:bg-gray-800/80 dark:highlight-white/10"
                >
                  <Icon class="aspect-w-1 w-6 h-6 aspect-h-1 bg-size-[100%]" name="tabler:cash" />
                </div>
                <h2 class="mt-0.5 mb-4 text-3xl lg:text-4xl font-bold font-heading">
                  Help Us Keep CachyOS Free
                </h2>
              </div>

              <p class="mb-8 text-xl text-gray-600 dark:text-gray-400">
                CachyOS is built and maintained by a small team of open-source contributors. Your
                support helps cover infrastructure costs and keeps development going.
              </p>

              <div class="flex w-full sm:w-auto space-x-4">
                <SupportOptions client:load>
                  <Icon name="tabler:arrow-up-right" class="w-5 h-5 mr-1 -ml-1.5" /> Donate
                </SupportOptions>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
