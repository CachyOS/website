---
// Generated by localize.dev: in <head>, this page in every language (hreflang), its canonical
// address and og:locale, so search engines show each language its own page.
import { defaultLang, getLangFromUrl, languages, localizePath } from './index';

interface Props {
  /** false when the layout sets its own canonical link. */
  canonical?: boolean;
}

const OG_LOCALES: Record<string, string> = { en: 'en_US', eu: 'eu' };
const SITE: string | null = import.meta.env.VERCEL_PROJECT_PRODUCTION_URL
  ? `https://${import.meta.env.VERCEL_PROJECT_PRODUCTION_URL}`
  : import.meta.env.NETLIFY && import.meta.env.URL
    ? import.meta.env.URL
    : import.meta.env.RENDER_EXTERNAL_URL
      ? import.meta.env.RENDER_EXTERNAL_URL
      : import.meta.env.RAILWAY_PUBLIC_DOMAIN
        ? `https://${import.meta.env.RAILWAY_PUBLIC_DOMAIN}`
        : null;
const { canonical = true } = Astro.props;
const lang = getLangFromUrl(Astro.url);
// Search engines need full addresses: the site from astro.config, else siteUrl.
const site = Astro.site?.href ?? SITE;
const href = (l: string) =>
  site
    ? new URL(localizePath(Astro.url.pathname.replace(/(.)\/$/, '$1'), l), site).href
    : localizePath(Astro.url.pathname.replace(/(.)\/$/, '$1'), l);
---

{canonical && <link rel="canonical" href={href(lang)} />}
{languages.map((l) => <link rel="alternate" hreflang={l} href={href(l)} />)}
<link rel="alternate" hreflang="x-default" href={href(defaultLang)} />
<meta property="og:locale" content={OG_LOCALES[lang] ?? lang} />
{
  languages
    .filter((l) => l !== lang)
    .map((l) => <meta property="og:locale:alternate" content={OG_LOCALES[l] ?? l} />)
}
